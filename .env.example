# ── Clerk authentication ────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ── PostgreSQL (Supabase / Neon / any provider) ─────────────────────────────
# Use the *Transaction pooler* URI on serverless hosts (Supabase port 6543)
DATABASE_URL=postgresql://user:password@host:6543/postgres

# ── Transactional email (n8n + Resend) ──────────────────────────────────────
# The app never sends email directly — it POSTs event data here and n8n
# formats + sends via Resend. One shared webhook is enough to start (route on
# the `event` field with a Switch node in n8n); split later with the
# per-event overrides below if you want separate workflows — no code changes
# needed either way.
N8N_EMAIL_WEBHOOK_URL=https://your-n8n-instance/webhook/booking-emails
# Optional: sent as X-Webhook-Secret so n8n can verify the request came from this app
N8N_WEBHOOK_SECRET=
# Optional per-event overrides — checked first, fall back to N8N_EMAIL_WEBHOOK_URL
# N8N_WEBHOOK_URL_BOOKING_CONFIRMATION=
# N8N_WEBHOOK_URL_APPOINTMENT_REMINDER=
# N8N_WEBHOOK_URL_CANCELLATION=
# N8N_WEBHOOK_URL_RESCHEDULE=

# ── Reminder cron job ────────────────────────────────────────────────────────
# Protects GET /api/cron/reminders (polled by Vercel Cron — see vercel.json).
# Set this in production; without it the endpoint runs unprotected.
CRON_SECRET=
