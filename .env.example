# Google Sheets API Configuration
# See README.md for setup instructions

# ---------------------------------------------------------------------------
# Master "Clients" spreadsheet (yours) — one row per client/business that
# logs into this app. Maps each client's login email to the spreadsheet that
# holds THEIR bookings.
# Columns: ClientName | ClientEmail | SpreadsheetID | SheetName | Phone | Notes
# ---------------------------------------------------------------------------
# ── PostgreSQL (Supabase / Neon / any provider) ─────────────────────────────
# Use the *Transaction pooler* URI on serverless hosts (Supabase port 6543)
DATABASE_URL=postgresql://user:password@host:6543/postgres

# ── Legacy Google Sheets (removed in Phase 4 — only needed for data import) ─
GOOGLE_CLIENTS_SHEET_ID=your_clients_spreadsheet_id_here
GOOGLE_CLIENTS_SHEET_NAME=Clients

# ---------------------------------------------------------------------------
# Legacy single-sheet vars — no longer used directly by the app now that
# each client's spreadsheet ID/tab comes from the Clients sheet above.
# Safe to remove once you've migrated.
# ---------------------------------------------------------------------------
GOOGLE_SHEET_ID=your_spreadsheet_id_here
GOOGLE_SHEET_NAME=Sheet1

# Google Service Account credentials (paste the full JSON as a single line,
# or use GOOGLE_SERVICE_ACCOUNT_KEY_PATH to point to the JSON file)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END RSA PRIVATE KEY-----\n"
