# Google Sheets API Configuration
# See README.md for setup instructions

# Your Google Sheet ID (found in the sheet URL)
# e.g. https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
GOOGLE_SHEET_ID=your_spreadsheet_id_here

# Name of the sheet tab (default: Sheet1)
GOOGLE_SHEET_NAME=Sheet1

# Google Service Account credentials (paste the full JSON as a single line,
# or use GOOGLE_SERVICE_ACCOUNT_KEY_PATH to point to the JSON file)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END RSA PRIVATE KEY-----\n"
